# Copy to backend.hcl (not committed) and run:
#   terraform init -backend-config=backend.hcl
# The state bucket is created once, by hand, before the first init (infra/README.md).
bucket       = "astra-tfstate-123456789012"
key          = "pre-adoption/terraform.tfstate"
region       = "ap-northeast-2"
encrypt      = true
use_lockfile = true
