# compose.yaml이 읽는 설정. 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다(.gitignore).
# api와 worker는 이 파일의 값을 모두 환경 변수로 받는다. converter, transcoder, mysql은 받지 않는다.
# 형식: KEY=value. $가 들어 있는 값(bcrypt hash 등)은 작은따옴표로 감싼다. 쓰지 않는 선택 값은 주석으로 둔다.
# 빈 값(KEY=)을 남기지 않는다. 일부 설정은 값이 비어 있어도 "설정됨"으로 본다.

# ---- compose ----
# 함께 띄울 선택 서비스. mysql: 같은 host의 MySQL. scan: ClamAV. RDS를 쓰면 mysql을 뺀다. 예: mysql,scan
COMPOSE_PROFILES=mysql
# 실행할 이미지. 기본은 로컬에서 만든 astra-backend:local
# ASTRA_IMAGE=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/astra-backend:<tag>
# converter 역할 이미지(Dockerfile target converter, LibreOffice 포함). 기본은 astra-backend-converter:local
# ASTRA_CONVERTER_IMAGE=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/astra-backend-converter:<tag>
# api port를 publish할 host 주소와 port. 기본 127.0.0.1:8080. CloudFront VPC origin이 붙는 EC2에서는 0.0.0.0으로 둔다
# ASTRA_API_BIND=127.0.0.1
# ASTRA_API_PORT=8080

# ---- DB (필수) ----
# 같은 host의 mysql 서비스면 아래 주소 그대로 둔다. RDS면 RDS endpoint로 바꾼다.
DB_URL=jdbc:mysql://mysql:3306/astra
DB_USERNAME=astra
DB_PASSWORD=change-me-db-password

# ---- 기관 시간대 (ADR-0039) ----
# DB의 일시와 API의 offset 없는 일시가 따르는 벽시계. 기본 Asia/Seoul. 앱이 DB session과 JVM을 이 값에 맞추고 시작할 때 확인한다.
# 서머타임이 있는 시간대는 받지 않는다. IANA 이름으로 넣는다. compose의 mysql 서비스도 이 값을 TZ로 받는다.
# ASTRA_TIME_ZONE=Asia/Seoul

# ---- object storage (S3 API, ADR-0007) ----
ASTRA_STORAGE_CONTENT_BUCKET=astra-content
ASTRA_STORAGE_DELIVERY_BUCKET=astra-delivery
ASTRA_STORAGE_REGION=ap-northeast-2
# AWS S3와 instance role이면 아래 넷을 두지 않는다. S3 호환 저장소를 쓸 때만 주소와 key를 넣는다.
# ASTRA_STORAGE_ENDPOINT=https://s3.example.internal
# ASTRA_STORAGE_ACCESS_KEY=change-me-access-key
# ASTRA_STORAGE_SECRET_KEY=change-me-secret-key
# ASTRA_STORAGE_PATH_STYLE=true

# ---- 로그인과 session (ADR-0004) ----
# break-glass 계정. 셋이 모두 있어야 켜진다.
# ASTRA_BREAK_GLASS_EXTERNAL_REF=break-glass-admin
# ASTRA_BREAK_GLASS_PASSWORD_HASH='{bcrypt}$2a$10$change-me'
# ASTRA_BREAK_GLASS_TOTP_SECRET=CHANGEMEBASE32
# 상태를 바꾸는 요청에 허용하는 Origin(필수, 쉼표 구분). 브라우저 주소창의 origin을 그대로 적는다(scheme://host[:port], 끝의 / 없이).
# 브라우저는 api에 직접 오지 않고 앞단(CloudFront, 또는 프론트엔드 서버 Frontend-final server.mjs)을 거치므로 앱은 요청에서 자기 공개
# origin을 알 수 없다. 없으면 compose가 구성을 거부하고, 다르면 GET만 되고 POST·PUT·DELETE는 모두 403 forbidden이다.
# 프론트엔드 서버를 이 host에서 함께 띄워 https://eclass.stack-edu.com으로 공개하는 구성의 값이다. 로컬 브라우저로 프론트엔드
# 서버(http://127.0.0.1:4190)에 붙어 확인하려면 그 origin도 쉼표로 더한다.
ASTRA_SESSION_ALLOWED_ORIGINS=https://eclass.stack-edu.com
# 브라우저 주소(로그인 기록, session, 학교 비밀번호 로그인·break-glass 로그인의 주소 단위 한도). 이 주소·범위(쉼표 구분)에서 온 연결에서만
# X-Forwarded-For를 오른쪽부터 읽고 여기 있는 주소는 건너뛴다. 없으면 연결한 쪽 주소를 쓰는데, 프론트엔드 서버 뒤에서는 그 주소가 모든
# 사용자에게 같아 한 사람이 학교 비밀번호를 30번 틀리면 15분 동안 모두의 학교 로그인이 429가 된다.
# 전제: 믿는 hop 바로 앞의 앞단이 받은 X-Forwarded-For 뒤에 자기가 본 주소를 덧붙여야 한다. 아래 값은 Cloudflare Tunnel → cloudflared
# (프론트엔드 container의 loopback) → server.mjs → api 구성의 값이다. Cloudflare가 브라우저 주소를 덧붙이고 server.mjs가 cloudflared
# (127.0.0.1)를 덧붙인다. server.mjs 앞에 덧붙이지 않는 앞단(header를 설정하지 않은 reverse proxy, TCP tunnel)을 두면 127.0.0.1 왼쪽
# 값은 브라우저가 보낸 것이라 위조한 주소가 기록되고 한도도 그 주소로 센다. 그 구성에서는 이 값을 두지 않는다.
# api가 보는 연결은 astra_egress network에서 온다(프론트엔드 container의 주소. server.mjs를 host에서 띄우면 그 bridge의 gateway).
# 마지막 범위는 이 host의 astra_egress 범위로 바꾼다. compose.yaml은 이 범위를 고정하지 않으므로 network를 다시 만들면 바뀔 수 있다.
# 그러면 header를 읽지 않을 뿐이다(모든 사용자가 다시 한 주소):
#   docker network inspect astra_egress --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# 배포 뒤 README "배포 전 .env 점검표" 5번의 위조 header 확인을 한다.
ASTRA_CLIENT_ADDRESS_TRUSTED_PROXIES=127.0.0.0/8,::1,172.18.0.0/16

# ---- 문서·영상 전달: 둘 중 하나만, 반드시 하나는 켠다 ----
# 서명이 없으면 api가 시작하지 않는다(compose.yaml의 ASTRA_DELIVERY_REQUIRED). 서명이 없으면 미리보기의 쪽 이미지, 요약의 쪽 그림,
# 강의 영상이 열리지 않기 때문이다.
# CloudFront가 /doc, /vod를 delivery bucket에서 내보낼 때(Terraform 배포, 배포 문서가 .env를 만든다). PEM은 줄바꿈을 \n으로 바꿔
# 큰따옴표 안에 한 줄로 넣는다.
# ASTRA_CLOUDFRONT_BASE_URL=https://lms.example.ac.kr
# ASTRA_CLOUDFRONT_KEY_PAIR_ID=K2CHANGEME
# ASTRA_CLOUDFRONT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nchange-me\n-----END PRIVATE KEY-----\n"
# CDN 없이 앱이 /doc, /vod를 직접 응답(ADR-0009). 프론트엔드 서버가 /doc, /vod를 api로 넘기는 구성은 이쪽이다.
# 서명 key는 Base64 32 byte 이상이고 비밀값이다. openssl rand -base64 32로 만든 값으로 바꾼다. 아래 자리표시 값으로는 시작하지 않는다.
ASTRA_DELIVERY_ORIGIN_ENABLED=true
ASTRA_DELIVERY_ORIGIN_SIGNING_KEY=change-me-base64-32-bytes

# ---- 외부 LLM (ADR-0008, ADR-0032). key가 없으면 쪽별 요약 생성과 학습 대화가 모두 꺼진다(503 llm_disabled) ----
# ASTRA_LLM_API_KEY=change-me-llm-key
# ASTRA_LLM_BASE_URL=https://api.deepseek.com
# ASTRA_LLM_MODEL=deepseek-flash
# ASTRA_LLM_VISION=true
# ASTRA_LLM_TIMEOUT=300s
# ASTRA_LLM_MAX_CONCURRENCY=2
# ASTRA_LLM_EXTRABODY_THINKING_TYPE=disabled

# ---- 업로드와 작업 주기 ----
# ASTRA_UPLOAD_TTL=24h
# ASTRA_UPLOAD_RATE_LIMIT=30
# ASTRA_UPLOAD_RATE_WINDOW=10m
# ASTRA_SUMMARY_POLL_INTERVAL=5s

# ---- 강의 영상 (ADR-0016) ----
# worker가 부르는 transcoder 주소는 compose.yaml이 worker에 넣는다(http://transcoder:8091). compose 밖에서 띄울 때만 둔다.
# ASTRA_TRANSCODER_URL=http://transcoder:8091
# 영상 하나의 변환과 응답을 기다리는 시간. transcoder의 TRANSCODER_TIMEOUT_SECONDS(compose.yaml)보다 길게 둔다
# ASTRA_TRANSCODER_TIMEOUT=3h
# ASTRA_TRANSCODER_WORKER_POLL_INTERVAL=10s
# ASTRA_TRANSCODER_WORKER_LEASE=10m
# ASTRA_TRANSCODER_WORKER_MAX_ATTEMPTS=3
# ASTRA_TRANSCODER_WORKER_RETRY_BACKOFF=1m
# 영상 업로드의 S3 multipart part 크기와 끝나지 않은 multipart upload를 정리하는 시간
# ASTRA_UPLOAD_STREAM_PART_SIZE=8MB
# ASTRA_UPLOAD_STREAM_ABANDON_AFTER=24h

# ---- 악성코드 검사 (ADR-0010, ADR-0018) ----
# COMPOSE_PROFILES에 scan을 넣을 때 아래 셋을 함께 켠다. scan 없이 띄우면 셋 다 두지 않는다(형식 검사만 한다).
# ASTRA_SCAN_REQUIRED=true면 검사기 설정이 없을 때 앱이 뜨지 않는다. 학교 자료를 받는 배포는 켠다.
# scan 프로필은 메모리를 3 GiB 넘게 더 쓴다. host 메모리가 8 GiB 이상이어야 한다.
# ASTRA_SCAN_CLAMD_HOST=clamav
# ASTRA_SCAN_CLAMD_PORT=3310
# ASTRA_SCAN_REQUIRED=true

# ---- 지표와 trace (ADR-0034). 기본은 내보내지 않는다 ----
# 켜면 수신 주소도 함께 넣는다. 주소 없이 켜면 앱이 뜨지 않는다. 수신 쪽(collector 등)은 이 compose에 없다.
# ASTRA_OTLP_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.internal:4318
# ASTRA_TRACING_SAMPLING_PROBABILITY=0.1

# ---- JVM ----
# 이미지의 기본 option(-XX:MaxRAMPercentage=60 등) 뒤에 붙어 같은 option이면 이 값이 이긴다.
# JAVA_OPTS=-XX:MaxRAMPercentage=50
