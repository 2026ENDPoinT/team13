[Unit]
Description=Hermes DB daily backup (gyeongmae, campus-on, e-class) + offsite rsync
After=docker.service postgresql.service
OnFailure=hermes-ops-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
ExecStart=/home/ubuntu/bin/hermes-db-backup
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
