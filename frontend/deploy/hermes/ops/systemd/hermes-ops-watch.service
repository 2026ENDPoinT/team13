[Unit]
Description=Hermes server watch (disk, memory, OOM, containers, units, HTTP, backups) -> Hermes agent Telegram
After=network-online.target docker.service
OnFailure=hermes-ops-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
Environment=XDG_RUNTIME_DIR=/run/user/1001
ExecStart=/home/ubuntu/bin/hermes-ops-watch
TimeoutStartSec=4min
