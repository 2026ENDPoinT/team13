[Unit]
Description=Hermes file/volume/SQLite daily backup (e-class S3, campus lesson_data, Hermes state.db) + offsite rsync
After=docker.service
OnFailure=hermes-ops-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
ExecStart=/home/ubuntu/bin/hermes-file-backup
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=3h
