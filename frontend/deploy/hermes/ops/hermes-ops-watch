#!/usr/bin/env python3
"""Hermes 서버 감시. hermes-ops-watch.timer 가 5분마다 돌리고, 문제가 생기면 헤르메스 에이전트 텔레그램 봇으로 알린다.

알림 경로: ~/.hermes/.env 의 TELEGRAM_BOT_TOKEN + ~/.hermes/state/agent-watch/config.json 의 chat_id
(헤르메스 agent-watch 와 같은 봇·대화방). 토큰은 출력하거나 기록하지 않는다.

점검: 디스크, 메모리·스왑·커밋, 커널 OOM, 컨테이너 상태·재시작·OOM, 핵심 systemd 유닛, 공개·내부 HTTP, 백업 나이.
같은 문제는 처음 한 번 알리고 6시간마다 다시 알린다. 풀리면 복구 알림을 보낸다. HTTP 는 2회 연속 실패해야 알린다.

  hermes-ops-watch                 점검하고 필요하면 알림
  hermes-ops-watch --dry-run       점검 결과만 출력(알림·상태 저장 없음)
  hermes-ops-watch --test          시험 메시지 전송
  hermes-ops-watch --unit-failed U systemd OnFailure 훅(hermes-ops-alert@.service)
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

HOME = Path.home()
HERMES = HOME / '.hermes'
STATE = HOME / '.local/state/hermes-ops-watch/state.json'
REMIND_S = 6 * 3600

DISK_WARN_PCT = 85
MEM_AVAILABLE_MIN = 1.5 * 2**30
SWAP_FREE_MIN = 1 * 2**30
COMMIT_MAX_RATIO = 0.95
BACKUP_MAX_AGE_S = 26 * 3600

SYSTEM_UNITS = ['docker', 'postgresql@16-main', 'gyeongmae-api', 'gyeongmae-web', 'gyeongmae-bot',
                'cloudflared-ybkim', 'tailscaled', 'hermes-db-backup.timer', 'hermes-file-backup.timer',
                'docker-cache-prune.timer', 'agy-llm-gateway']
USER_UNITS = ['hermes-gateway']
# (이름, URL, 정상으로 볼 상태 코드 범위)
HTTP_CHECKS = [
    ('stack-edu.com', 'https://stack-edu.com/', range(200, 400)),
    ('eclass.stack-edu.com', 'https://eclass.stack-edu.com/', range(200, 400)),  # Access 로그인 302 가 정상
    ('gm.ybkim.pe.kr', 'https://gm.ybkim.pe.kr/', range(200, 400)),
    ('e-class API', 'http://127.0.0.1:18080/api/auth/methods', range(200, 300)),
    ('경매 API', 'http://127.0.0.1:8080/api/health', range(200, 300)),
    ('주식 대시보드', 'http://127.0.0.1:8501/_stcore/health', range(200, 300)),
    ('e-class LLM 게이트웨이', 'http://172.24.0.1:18090/healthz', range(200, 300)),
]
BACKUP_DIRS = [('DB 백업(gyeongmae)', HOME / 'backups/db/gyeongmae'),
               ('파일 백업(hermes-state)', HOME / 'backups/files/hermes-state')]


def run(*cmd, env=None):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=60, env=env)


def meminfo():
    values = {}
    for line in Path('/proc/meminfo').read_text().splitlines():
        key, rest = line.split(':', 1)
        values[key] = int(rest.split()[0]) * 1024
    return values


def gib(n):
    return f'{n / 2**30:.1f}GiB'


def check_host(problems):
    usage = shutil.disk_usage('/')
    pct = usage.used * 100 / usage.total
    if pct >= DISK_WARN_PCT:
        problems['disk'] = f'디스크 {pct:.0f}% 사용 (남은 {gib(usage.free)})'
    m = meminfo()
    if m['MemAvailable'] < MEM_AVAILABLE_MIN:
        problems['mem'] = f'사용 가능 메모리 {gib(m["MemAvailable"])}'
    if m['SwapTotal'] and m['SwapFree'] < SWAP_FREE_MIN:
        problems['swap'] = f'스왑 남은 {gib(m["SwapFree"])} / {gib(m["SwapTotal"])}'
    if m['Committed_AS'] > m['CommitLimit'] * COMMIT_MAX_RATIO:
        problems['commit'] = f'메모리 예약 {m["Committed_AS"] * 100 / m["CommitLimit"]:.0f}% (한도 {gib(m["CommitLimit"])})'


def check_oom(events, since):
    out = run('journalctl', '-k', '--no-pager', '-o', 'cat', '--since', f'@{int(since)}').stdout
    killed = [line for line in out.splitlines() if re.search(r'Out of memory|oom-kill|Killed process', line)]
    if killed:
        names = sorted(set(re.findall(r'Killed process \d+ \(([^)]+)\)', '\n'.join(killed))))
        events.append(f'커널 OOM 발생: {", ".join(names) or "프로세스 확인 필요"}')


def check_containers(problems, events, state):
    ids = run('docker', 'ps', '-aq').stdout.split()
    if not ids:
        if run('docker', 'info').returncode != 0:
            problems['docker'] = 'Docker 데몬에 연결할 수 없음'
        return
    data = json.loads(run('docker', 'inspect', *ids).stdout)
    restarts = state.setdefault('restarts', {})
    seen = {}
    for c in data:
        name = c['Name'].lstrip('/')
        st = c['State']
        policy = c['HostConfig']['RestartPolicy']['Name']
        health = (st.get('Health') or {}).get('Status')
        if st['Status'] == 'restarting':
            problems[f'ctr:{name}'] = f'컨테이너 {name} 재시작 반복 중'
        elif st['Status'] in ('exited', 'dead') and policy in ('always', 'unless-stopped', 'on-failure'):
            if not (policy == 'on-failure' and st['ExitCode'] == 0):
                problems[f'ctr:{name}'] = f'컨테이너 {name} 멈춤 (exit {st["ExitCode"]})'
        elif health == 'unhealthy':
            problems[f'ctr:{name}'] = f'컨테이너 {name} unhealthy'
        count = c['RestartCount']
        if name in restarts and count > restarts[name]:
            events.append(f'컨테이너 {name} 재시작됨 ({restarts[name]}→{count}회)' + (' — OOM' if st.get('OOMKilled') else ''))
        seen[name] = count
    state['restarts'] = seen


def check_units(problems):
    for unit in SYSTEM_UNITS:
        if run('systemctl', 'is-active', '--quiet', unit).returncode != 0:
            problems[f'unit:{unit}'] = f'systemd {unit} 비활성'
    env = dict(os.environ, XDG_RUNTIME_DIR=f'/run/user/{os.getuid()}')
    for unit in USER_UNITS:
        if run('systemctl', '--user', 'is-active', '--quiet', unit, env=env).returncode != 0:
            problems[f'unit:{unit}'] = f'사용자 유닛 {unit} 비활성'


def check_http(problems):
    for name, url, ok in HTTP_CHECKS:
        request = urllib.request.Request(url, method='GET', headers={'User-Agent': 'hermes-ops-watch'})
        opener = urllib.request.build_opener(NoRedirect)
        try:
            with opener.open(request, timeout=15) as response:
                code = response.status
        except urllib.error.HTTPError as error:
            code = error.code
        except Exception as error:  # 연결 실패·시간 초과
            problems[f'http:{name}'] = f'{name} 응답 없음 ({type(error).__name__})'
            continue
        if code not in ok:
            problems[f'http:{name}'] = f'{name} HTTP {code}'


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def push_heartbeat(problems, now):
    """yoobin-desktop 의 바깥 감시(hermes-external-watch)가 읽는 heartbeat 를 갱신한다. 데스크톱(CI/CD·백업 사본)에 닿지 않으면 그것도 문제다."""
    try:
        result = subprocess.run(['ssh', '-n', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', 'desktop',
                                 f'echo {int(now)} > ~/hermes-ops-watch.heartbeat'],
                                capture_output=True, timeout=30)
        ok = result.returncode == 0
    except subprocess.TimeoutExpired:
        ok = False
    if not ok:
        problems['http:desktop'] = 'yoobin-desktop(Jenkins·백업 사본·바깥 감시)에 ssh 접속 불가'


def check_backups(problems, now):
    for name, directory in BACKUP_DIRS:
        files = [p for p in directory.glob('*') if p.is_file() and not p.name.startswith('.')] if directory.exists() else []
        newest = max((p.stat().st_mtime for p in files), default=0)
        if now - newest > BACKUP_MAX_AGE_S:
            age = '없음' if not newest else f'{(now - newest) / 3600:.0f}시간 전'
            problems[f'backup:{name}'] = f'{name} 최신 파일 {age}'


def telegram(text):
    token = None
    for line in (HERMES / '.env').read_text().splitlines():
        match = re.match(r'^\s*(?:export\s+)?TELEGRAM_BOT_TOKEN\s*=\s*(.+?)\s*$', line)
        if match:
            token = match[1].strip().strip('"\'')
            break
    chat_id = json.loads((HERMES / 'state/agent-watch/config.json').read_text())['chat_id']
    if not token:
        raise RuntimeError('Telegram token unavailable')
    body = urllib.parse.urlencode({'chat_id': chat_id, 'text': text}).encode()
    with urllib.request.urlopen(urllib.request.Request(
            'https://api.telegram.org/bot' + token + '/sendMessage', data=body), timeout=15) as response:
        if not json.load(response).get('ok'):
            raise RuntimeError('Telegram delivery rejected')


def load_state():
    try:
        return json.loads(STATE.read_text())
    except (FileNotFoundError, ValueError):
        return {}


def save_state(state):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix('.tmp')
    tmp.write_text(json.dumps(state, ensure_ascii=False, indent=1))
    tmp.replace(STATE)


def unit_failed(unit):
    tail = run('journalctl', '-u', unit, '--no-pager', '-o', 'cat', '-n', '6').stdout.strip()
    telegram(f'[Hermes 서버] {unit} 실패\n{tail[-1500:]}')


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--dry-run', action='store_true')
    parser.add_argument('--test', action='store_true')
    parser.add_argument('--unit-failed')
    args = parser.parse_args()
    os.umask(0o077)
    if args.test:
        telegram('[Hermes 서버] 감시 시작: 5분마다 디스크·메모리·OOM·컨테이너·서비스·사이트·백업을 점검합니다.')
        return 0
    if args.unit_failed:
        unit_failed(args.unit_failed)
        return 0

    now = time.time()
    state = load_state()
    problems, events = {}, []
    check_host(problems)
    check_oom(events, state.get('last_run', now - 300))
    check_containers(problems, events, state)
    check_units(problems)
    check_http(problems)
    check_backups(problems, now)
    if not args.dry_run:
        push_heartbeat(problems, now)

    if args.dry_run:
        print(json.dumps({'problems': problems, 'events': events}, ensure_ascii=False, indent=1))
        return 0

    active = state.setdefault('active', {})
    lines, recovered = [], []
    for key, message in problems.items():
        entry = active.setdefault(key, {'count': 0, 'since': now, 'sent': 0})
        entry['count'] += 1
        entry['message'] = message
        needed = 2 if key.startswith('http:') else 1
        if entry['count'] >= needed and now - entry['sent'] >= REMIND_S:
            lines.append(('계속: ' if entry['sent'] else '') + message)
            entry['sent'] = now
    for key in [k for k in active if k not in problems]:
        if active[key]['sent']:
            recovered.append(active[key]['message'])
        del active[key]

    text = []
    if lines or events:
        text.append('[Hermes 서버] 문제')
        text += ['• ' + line for line in events + lines]
    if recovered:
        text.append('[Hermes 서버] 복구')
        text += ['• ' + line for line in recovered]
    if text:
        try:
            telegram('\n'.join(text))
        except Exception:
            for key in active:  # 다음 실행에서 다시 보낸다
                if active[key]['sent'] == now:
                    active[key]['sent'] = 0
            state['last_run'] = state.get('last_run', now)
            save_state(state)
            print('telegram delivery failed')
            return 1
    state['last_run'] = now
    save_state(state)
    print(json.dumps({'problems': list(problems), 'events': len(events), 'sent': bool(text)}, ensure_ascii=False))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
