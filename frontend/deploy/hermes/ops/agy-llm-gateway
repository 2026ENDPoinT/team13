#!/usr/bin/env python3
"""e-class 백엔드용 LLM 게이트웨이(OpenAI Chat Completions 호환). systemd agy-llm-gateway.service 가 띄운다.

  1순위: Hive API 의 DeepSeek(reasoning_effort=low). 빠르고 이미지도 읽는다.
  2순위: DeepSeek 가 실패(시간 초과·5xx·429·빈 답)하면 Google Antigravity 구독의 Gemini 4 Hydrogen — 헤르메스 플러그인
         antigravity-agy 의 transport 로 로그인된 agy CLI 를 한 번 실행한다(텍스트만, 도구 호출 지원).
         - 이미지가 든 요청은 Gemini 로 넘기지 않는다(agy 가 이미지를 빼고 글자만 보내 그림을 못 본 답이 오류 없이 온다).
         - 쿼터 초과·로그아웃·agy 없음 → 15분, 그 밖의 실패 → 1분 동안 agy 를 건너뛴다(차단기). DeepSeek 도 실패가
           이어지면 DEEPSEEK_COOLDOWN 동안 건너뛰고 Gemini 로 바로 보낸다.

백엔드(api·worker 컨테이너)는 같은 컨테이너 안 127.0.0.1:18090 의 socat 중계(llm-relay-*)를 거쳐
이 게이트웨이(astra-egress 브리지 172.24.0.1:18090)로 온다. 백엔드 설정은 http 를 loopback 에만 허용한다.

설정: /home/ubuntu/.config/agy-llm-gateway/env (600)
  GATEWAY_TOKEN             백엔드가 보내는 Bearer 값(ASTRA_LLM_API_KEY)
  DEEPSEEK_BASE_URL         https://api-cdn.thehive.ai/api/v3
  DEEPSEEK_MODEL            deepseek-ai/deepseek-v4.1-flash-1017
  DEEPSEEK_API_KEY          Hive API key
  DEEPSEEK_REASONING_EFFORT 기본 low
  DEEPSEEK_TIMEOUT          DeepSeek 한 번의 제한 시간(초), 기본 150
  DEEPSEEK_COOLDOWN         DeepSeek 실패 뒤 건너뛰는 시간(초), 기본 30
  AGY_MODEL                 기본 gemini-4-hydrogen-medium
  AGY_TIMEOUT               agy 한 번의 제한 시간(초), 기본 60
  AGY_COOLDOWN              일반 실패 뒤 agy 를 건너뛰는 시간(초), 기본 60
  AGY_HARD_COOLDOWN         쿼터·로그아웃 뒤 건너뛰는 시간(초), 기본 900
  LISTEN                    172.24.0.1:18090
기록: 요청마다 한 줄(사용 경로·시간·토큰 수). 프롬프트·응답 본문은 남기지 않는다.
"""
import hmac
import json
import os
import re
import sys
import threading
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

PLUGIN = Path.home() / '.hermes/plugins/antigravity-agy'
sys.path.insert(0, str(PLUGIN))
import transport  # noqa: E402  헤르메스 antigravity-agy 플러그인

ENV = os.environ
TOKEN = ENV['GATEWAY_TOKEN']
AGY_MODEL = ENV.get('AGY_MODEL', 'gemini-4-hydrogen-medium')
AGY_TIMEOUT = float(ENV.get('AGY_TIMEOUT', '60'))
AGY_COOLDOWN = float(ENV.get('AGY_COOLDOWN', '60'))
AGY_HARD_COOLDOWN = float(ENV.get('AGY_HARD_COOLDOWN', '900'))
HARD_ERRORS = (transport.AgyQuotaExhausted, transport.AgyLoggedOut, transport.AgyMissing)
# 백엔드 ASTRA_LLM_TIMEOUT(300s) 안에 DeepSeek 와 Gemini 를 함께 끝낸다. 2순위에는 남은 시간만 준다.
REQUEST_BUDGET = float(ENV.get('REQUEST_BUDGET', '290'))
DS_URL = ENV['DEEPSEEK_BASE_URL'].rstrip('/') + '/chat/completions'
DS_MODEL = ENV['DEEPSEEK_MODEL']
DS_KEY = ENV['DEEPSEEK_API_KEY']
DS_EFFORT = ENV.get('DEEPSEEK_REASONING_EFFORT', 'low')
DS_TIMEOUT = float(ENV.get('DEEPSEEK_TIMEOUT', '150'))
DS_COOLDOWN = float(ENV.get('DEEPSEEK_COOLDOWN', '30'))
HOST, PORT = ENV.get('LISTEN', '172.24.0.1:18090').rsplit(':', 1)
MAX_BODY = 16 * 2**20
# agy 는 헤르메스 에이전트와 같은 Antigravity 구독 쿼터(5시간·주간)를 쓴다. 동시에 AGY_CONCURRENCY(기본 8)개까지 띄우고,
# 자리가 없으면 기다리지 않고 실패로 본다(DeepSeek 쪽 동시 수는 백엔드 ASTRA_LLM_MAX_CONCURRENCY 가 정한다).
AGY_SLOTS = threading.BoundedSemaphore(int(ENV.get('AGY_CONCURRENCY', '8')))
client = transport.Client(timeout=AGY_TIMEOUT)


class Breaker:
    """실패가 이어질 때 그 제공자를 잠시 건너뛴다. 요청마다 안 되는 쪽을 기다리지 않게 한다."""

    def __init__(self, name, cooldown, hard_errors=(), hard_cooldown=0.0):
        self.name, self.cooldown, self.hard_errors, self.hard_cooldown = name, cooldown, hard_errors, hard_cooldown
        self.lock = threading.Lock()
        self.open_until = 0.0
        self.reason = None

    def skip(self):
        with self.lock:
            return self.reason if time.monotonic() < self.open_until else None

    def trip(self, error):
        seconds = self.hard_cooldown if self.hard_errors and isinstance(error, self.hard_errors) else self.cooldown
        with self.lock:
            self.open_until = max(self.open_until, time.monotonic() + seconds)
            self.reason = type(error).__name__
        log(event=f'{self.name}_paused', reason=self.reason, seconds=int(seconds))

    def reset(self):
        with self.lock:
            self.open_until, self.reason = 0.0, None


breaker = Breaker('agy', AGY_COOLDOWN, HARD_ERRORS, AGY_HARD_COOLDOWN)
ds_breaker = Breaker('deepseek', DS_COOLDOWN)


class Skipped(Exception):
    """그 제공자를 부르지 않고 넘어간다(차단기 열림·자리 없음). 차단기를 다시 걸지 않는다."""


class EmptyAnswer(Exception):
    """DeepSeek 가 본문도 도구 호출도 없이 답했다(추론이 max_tokens 를 다 쓴 경우 등)."""


def log(**fields):
    print(json.dumps({'at': time.strftime('%Y-%m-%dT%H:%M:%S'), **fields}, ensure_ascii=False), flush=True)


def via_agy(body, model=None, timeout=None, short=False):
    """short: 도우미처럼 일부러 짧게 끊는 요청. 시간 초과 같은 일시 실패로는 차단기를 걸지 않는다(쿼터·로그아웃·agy 없음만 건다).
    걸면 Hermes 에이전트·녹음 요약 같은 다른 요청까지 AGY_COOLDOWN 동안 agy 를 못 쓴다."""
    model, timeout = model or AGY_MODEL, timeout or AGY_TIMEOUT
    paused = breaker.skip()
    if paused:
        raise Skipped(f'agy paused:{paused}')
    if not AGY_SLOTS.acquire(blocking=False):
        raise Skipped('agy busy')
    kwargs = {k: body[k] for k in ('messages', 'tools', 'tool_choice') if k in body}
    try:
        response = client.chat.completions.create(model=model, timeout=timeout, **kwargs)
    except Exception as error:
        if not short or isinstance(error, HARD_ERRORS):
            breaker.trip(error)
        raise
    finally:
        AGY_SLOTS.release()
    breaker.reset()
    data = response.model_dump()
    data['model'] = model
    return data


def via_deepseek(body, timeout):
    """DeepSeek 한 번. 성공하면 Chat Completions 응답(dict). 시간 초과·5xx·429·빈 답이면 예외(차단기를 건다).
    그 밖의 4xx 는 요청 자체 문제라 차단기를 걸지 않고 예외로 넘긴다."""
    paused = ds_breaker.skip()
    if paused:
        raise Skipped(f'deepseek paused:{paused}')
    payload = dict(body, model=DS_MODEL)
    payload.pop('thinking', None)
    payload['reasoning_effort'] = DS_EFFORT
    request = urllib.request.Request(DS_URL, data=json.dumps(payload).encode(), method='POST', headers={
        'Authorization': f'Bearer {DS_KEY}', 'Content-Type': 'application/json'})
    try:
        with urllib.request.urlopen(request, timeout=max(1.0, timeout)) as response:
            data = json.load(response)
        message = data['choices'][0]['message']
        if not (message.get('content') or '').strip() and not message.get('tool_calls'):
            raise EmptyAnswer(data['choices'][0].get('finish_reason'))
    except urllib.error.HTTPError as error:
        if error.code == 429 or error.code >= 500:
            ds_breaker.trip(error)
        raise
    except Exception as error:
        ds_breaker.trip(error)
        raise
    ds_breaker.reset()
    message.pop('reasoning_content', None)
    data['model'] = DS_MODEL
    return data


# ---------- 프론트 AI 도우미(마스코트 챗봇): Gemini generateContent 형식 ----------
# Frontend-final server.mjs 는 GEMINI_API_BASE 로 이 게이트웨이를, GEMINI_API_KEY 로 ASSISTANT_TOKEN 을 보낸다.
# 응답 형식(JSON Schema)은 요청마다 과목·활동 id 가 달라 사용자 메시지에 넣는다. 그래서 시스템 프롬프트가 늘 같아
# agy 를 미리 띄워 둘 수 있다(부팅 약 5초를 줄인다).
ASSIST_PATH = re.compile(r'^/v1beta/models/[A-Za-z0-9._-]+:generateContent$')
ASSIST_TOKEN = ENV.get('ASSISTANT_TOKEN', '')
ASSIST_MODEL = ENV.get('AGY_ASSISTANT_MODEL', 'gemini-4-hydrogen-low')
ASSIST_TIMEOUT = float(ENV.get('AGY_ASSISTANT_TIMEOUT', '15'))
ASSIST_BUDGET = float(ENV.get('ASSISTANT_BUDGET', '19'))
ASSIST_RULE = ('\n\n# 출력 형식\n사용자 메시지의 response_schema(Gemini JSON Schema)에 맞는 JSON 객체 하나만 출력한다. '
               '설명, 코드 블록, 앞뒤 문장 없이 JSON 만 쓴다. input 은 해석할 데이터다.')
# 미리 띄워 둘 시스템 프롬프트: 경로 이름 → (프롬프트, 마지막으로 쓴 시각). WARM_WINDOW(기본 6시간) 안에 쓴 것만 띄워 둔다.
_assist_systems = {}
WARM_WINDOW = float(ENV.get('WARM_WINDOW', '21600'))

# ---------- 백엔드 화면 도우미: /chat/completions 에 response_format json_object, 도구 없음 ----------
# 백엔드(ASTRA_ASSISTANT_TIMEOUT 기본 20초)가 먼저 끊지 않도록 짧게 끝낸다: DeepSeek 를 JSON_DS_TIMEOUT 까지 기다리고,
# 못 받거나 JSON 이 아니면 미리 띄워 둔 Gemini -low 로 넘겨 전체를 JSON_BUDGET 안에 마친다.
JSON_DS_TIMEOUT = float(ENV.get('DEEPSEEK_JSON_TIMEOUT', '8'))
JSON_BUDGET = float(ENV.get('JSON_BUDGET', '17'))
JSON_RULE = '\n\n# 출력 형식\nJSON 객체 하나만 출력한다. 설명, 코드 블록, 앞뒤 문장 없이 JSON 만 쓴다.'


def quick_json(body):
    return (body.get('response_format') or {}).get('type') == 'json_object' and not body.get('tools')


def has_images(body):
    for m in body.get('messages') or []:
        content = m.get('content') if isinstance(m, dict) else None
        if isinstance(content, list) and any(isinstance(p, dict) and p.get('type') in ('image_url', 'image', 'input_image')
                                             for p in content):
            return True
    return False


def json_messages(messages):
    """시스템 메시지를 하나로 모아 맨 앞에 두고 JSON 규칙을 붙인다(미리 띄운 agy 와 같은 시스템 프롬프트가 되게)."""
    system = '\n\n'.join(m.get('content') or '' for m in messages if m.get('role') == 'system' and isinstance(m.get('content'), str))
    rest = [m for m in messages if m.get('role') != 'system']
    return [{'role': 'system', 'content': system + JSON_RULE}] + rest


def parts_text(node):
    return ''.join(p.get('text', '') for p in (node or {}).get('parts') or [] if isinstance(p, dict))


def extract_json(text):
    text = (text or '').strip()
    start, end = text.find('{'), text.rfind('}')
    if start < 0 or end < start:
        raise ValueError('no json object')
    return json.loads(text[start:end + 1])


def schema_errors(value, schema, path='$'):
    """Gemini responseSchema 의 쓰는 부분(type·enum·nullable·required·items·maxItems)만 확인한다.
    프론트 server.mjs 가 같은 조건으로 거르므로, 어긋난 답은 여기서 다시 묻거나 바꾼다."""
    if not isinstance(schema, dict):
        return []
    kind = str(schema.get('type', '')).upper()
    if value is None:
        return [] if schema.get('nullable') or kind == 'NULL' else [f'{path} 는 null 일 수 없다']
    if kind == 'NULL':
        return [f'{path} 는 null 이어야 한다']
    if kind == 'OBJECT':
        if not isinstance(value, dict):
            return [f'{path} 는 객체여야 한다']
        props = schema.get('properties') or {}
        errors = [f'{path}.{k} 가 없다' for k in schema.get('required') or [] if k not in value]
        for k, sub in props.items():
            if k in value:
                errors += schema_errors(value[k], sub, f'{path}.{k}')
        return errors
    if kind == 'ARRAY':
        if not isinstance(value, list):
            return [f'{path} 는 배열이어야 한다']
        errors = [f'{path} 는 {schema["maxItems"]}개 이하여야 한다'] if 'maxItems' in schema and len(value) > int(schema['maxItems']) else []
        for i, item in enumerate(value):
            errors += schema_errors(item, schema.get('items'), f'{path}[{i}]')
        return errors
    if kind == 'STRING' and not isinstance(value, str):
        return [f'{path} 는 문자열이어야 한다']
    if 'enum' in schema and value not in schema['enum']:
        return [f'{path} 는 {schema["enum"]} 중 하나여야 한다(받은 값 {value!r})']
    return []


def safe_answer(schema):
    """두 모델 모두 형식을 못 맞추면 되묻는 답으로 바꾼다(clarify 가 없으면 none)."""
    kinds = (((schema or {}).get('properties') or {}).get('kind') or {}).get('enum') or []
    kind = 'clarify' if 'clarify' in kinds else 'none'
    return {'kind': kind, 'intent': None, 'courseId': None, 'targets': [], 'say': '무엇을 할지 조금 더 구체적으로 말씀해 주세요.'}


def assistant_messages(body):
    system = parts_text(body.get('systemInstruction')) + ASSIST_RULE
    user = '\n'.join(parts_text(c) for c in body.get('contents') or [])
    schema = (body.get('generationConfig') or {}).get('responseSchema')
    prompt = 'response_schema:\n' + json.dumps(schema, ensure_ascii=False) + '\n\ninput:\n' + user
    return [{'role': 'system', 'content': system}, {'role': 'user', 'content': prompt}], schema


def prewarm_assistant():
    """최근에 쓴 도우미 시스템 프롬프트마다 agy 하나를 부팅해 둔다(헤르메스 플러그인의 WarmPool, 5분 TTL). 이미 있으면 그대로 둔다."""
    if breaker.skip() is not None:
        return
    now = time.monotonic()
    for route, (system, seen) in list(_assist_systems.items()):
        if now - seen > WARM_WINDOW:
            _assist_systems.pop(route, None)
            continue
        try:
            env = dict(os.environ)
            resolved = transport.resolve_agy(client.command, env)
            if resolved is not None:
                spec = (resolved, transport.native_model(ASSIST_MODEL), transport.system_prompt(system, []), [], env)
                transport.POOL.prewarm(transport.pool_key(*spec), spec, transport.DEFAULT_PREWARM_TTL, 1)
        except Exception as error:
            log(event='assistant_prewarm_failed', route=route, error=type(error).__name__)


def keep_assistant_warm():
    while True:
        prewarm_assistant()
        time.sleep(30)


def assistant_reply(value, model):
    text = json.dumps(value, ensure_ascii=False)
    return {'candidates': [{'content': {'role': 'model', 'parts': [{'text': text}]}, 'finishReason': 'STOP', 'index': 0}],
            'modelVersion': model}


def deepseek_json(messages, remaining):
    payload = {'model': DS_MODEL, 'messages': messages, 'temperature': 0, 'max_tokens': 800,
               'response_format': {'type': 'json_object'}, 'reasoning_effort': 'none', 'stream': False}
    request = urllib.request.Request(DS_URL, data=json.dumps(payload).encode(), method='POST', headers={
        'Authorization': f'Bearer {DS_KEY}', 'Content-Type': 'application/json'})
    with urllib.request.urlopen(request, timeout=max(3.0, remaining)) as response:
        data = json.load(response)
    return data['choices'][0]['message'].get('content') or ''


def assistant_fallback(messages, schema, deadline):
    """DeepSeek 로 묻고, 형식이 어긋나면 이유를 알려 한 번 더 묻는다. 그래도 어긋나면 되묻는 답. (값, 재시도 여부, 대체 여부)"""
    raw = deepseek_json(messages, deadline - time.monotonic())
    try:
        value = extract_json(raw)
        errors = schema_errors(value, schema)
    except ValueError:
        value, errors = None, ['JSON 객체가 아니다']
    if not errors:
        return value, False, False
    if deadline - time.monotonic() < 3:
        return safe_answer(schema), False, True
    retry = messages + [{'role': 'assistant', 'content': raw[:2000]},
                        {'role': 'user', 'content': '응답이 response_schema 와 맞지 않는다: ' + '; '.join(errors[:5])
                                                    + '. enum 에 있는 값만 써서 JSON 객체 하나로 다시 답하라.'}]
    try:
        value = extract_json(deepseek_json(retry, deadline - time.monotonic()))
        if not schema_errors(value, schema):
            return value, True, False
    except ValueError:
        pass
    return safe_answer(schema), True, True


class Handler(BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'

    def log_message(self, *_):
        pass

    def reply(self, status, data):
        raw = data if isinstance(data, bytes) else json.dumps(data, ensure_ascii=False).encode()
        self.send_response(status)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def do_GET(self):
        if self.path == '/healthz':
            return self.reply(200, {'ok': True, 'primary': DS_MODEL, 'fallback': AGY_MODEL,
                                    'primary_paused': ds_breaker.skip(), 'fallback_paused': breaker.skip()})
        self.reply(404, {'error': {'message': 'not found'}})

    def assistant(self):
        key = self.headers.get('x-goog-api-key', '')
        if not ASSIST_TOKEN or not hmac.compare_digest(key.encode(), ASSIST_TOKEN.encode()):
            return self.reply(401, {'error': {'message': 'unauthorized'}})
        length = int(self.headers.get('Content-Length') or 0)
        if length <= 0 or length > MAX_BODY:
            return self.reply(413, {'error': {'message': 'bad body size'}})
        try:
            messages, schema = assistant_messages(json.loads(self.rfile.read(length)))
        except (ValueError, AttributeError, TypeError):
            return self.reply(400, {'error': {'message': 'invalid request'}})
        _assist_systems['generate'] = (messages[0]['content'], time.monotonic())
        started = time.monotonic()
        try:
            data = via_agy({'messages': messages}, ASSIST_MODEL, ASSIST_TIMEOUT, short=True)
            value = extract_json(data['choices'][0]['message'].get('content'))
            errors = schema_errors(value, schema)
            if errors:
                raise ValueError('schema: ' + '; '.join(errors[:3]))
            log(route='assistant-agy', model=ASSIST_MODEL, ms=int((time.monotonic() - started) * 1000))
            return self.reply(200, assistant_reply(value, ASSIST_MODEL))
        except Exception as error:  # agy 실패·형식 어긋남 → DeepSeek
            reason = type(error).__name__ if not str(error).startswith('schema:') else 'SchemaMismatch'
        finally:
            # 이 요청이 미리 띄운 agy 를 가져갔으므로 다음 요청을 위해 곧바로 하나를 새로 띄운다.
            threading.Thread(target=prewarm_assistant, daemon=True).start()
        fb_started = time.monotonic()
        try:
            value, retried, replaced = assistant_fallback(messages, schema, started + ASSIST_BUDGET)
        except Exception as error:
            log(route='assistant-fallback', error=type(error).__name__, agy_error=reason)
            return self.reply(502, {'error': {'message': f'primary ({reason}) and fallback failed'}})
        log(route='assistant-fallback', model=DS_MODEL, agy_error=reason, retried=retried, replaced=replaced,
            agy_ms=int((fb_started - started) * 1000), ms=int((time.monotonic() - fb_started) * 1000))
        self.reply(200, assistant_reply(value, DS_MODEL))

    def do_POST(self):
        if ASSIST_PATH.match(self.path.split('?', 1)[0]):
            return self.assistant()
        if not self.path.endswith('/chat/completions'):
            return self.reply(404, {'error': {'message': 'not found'}})
        auth = self.headers.get('Authorization', '')
        if not hmac.compare_digest(auth.encode(), f'Bearer {TOKEN}'.encode()):
            return self.reply(401, {'error': {'message': 'unauthorized'}})
        length = int(self.headers.get('Content-Length') or 0)
        if length <= 0 or length > MAX_BODY:
            return self.reply(413, {'error': {'message': 'bad body size'}})
        try:
            body = json.loads(self.rfile.read(length))
        except ValueError:
            return self.reply(400, {'error': {'message': 'invalid json'}})
        if body.get('stream'):
            return self.reply(400, {'error': {'message': 'stream is not supported'}})
        if quick_json(body) and isinstance(body.get('messages'), list):
            return self.quick(body)
        started = time.monotonic()
        if has_images(body):
            # agy 플러그인은 이미지를 "[image omitted …]" 로 바꿔 글자만 넘기므로, 이미지가 든 요청은 Gemini 로 넘기지 않는다.
            try:
                data = via_deepseek(body, min(DS_TIMEOUT, REQUEST_BUDGET))
            except Exception as error:
                log(route='vision', error=type(error).__name__, ms=self.elapsed(started))
                return self.reply(502, {'error': {'message': f'deepseek failed ({type(error).__name__}); images are not sent to Gemini'}})
            return self.answer(data, 'vision', started, body)
        try:
            data = via_deepseek(body, min(DS_TIMEOUT, REQUEST_BUDGET))
        except Exception as error:  # 시간 초과·5xx·429·빈 답·차단기 → 2순위 Gemini
            reason = type(error).__name__
        else:
            return self.answer(data, 'deepseek', started, body)
        try:
            data = via_agy(body, AGY_MODEL, min(AGY_TIMEOUT, max(5.0, REQUEST_BUDGET - (time.monotonic() - started))))
        except Exception as error:
            log(route='agy-fallback', error=type(error).__name__, ds_error=reason, ms=self.elapsed(started))
            return self.reply(502, {'error': {'message': f'primary ({reason}) and fallback ({type(error).__name__}) failed'}})
        self.answer(data, 'agy-fallback', started, body, ds_error=reason)

    @staticmethod
    def elapsed(started):
        return int((time.monotonic() - started) * 1000)

    def answer(self, data, route, started, body, **extra):
        usage = data.get('usage') or {}
        log(route=route, model=data.get('model'), ms=self.elapsed(started), tools=len(body.get('tools') or []),
            prompt=usage.get('prompt_tokens'), completion=usage.get('completion_tokens'),
            finish=(data.get('choices') or [{}])[0].get('finish_reason'), **extra)
        self.reply(200, data)

    def quick(self, body):
        """백엔드 화면 도우미(json_object, 백엔드 20초 제한): DeepSeek 를 JSON_DS_TIMEOUT 까지, 안 되면 미리 띄운 Gemini -low 로
        남은 시간(JSON_BUDGET 까지) 안에 끝낸다. 답은 JSON 객체 하나로 다듬어 돌려준다."""
        started = time.monotonic()
        try:
            data = via_deepseek(body, JSON_DS_TIMEOUT)
            message = data['choices'][0]['message']
            message['content'] = json.dumps(extract_json(message.get('content')), ensure_ascii=False)
        except Exception as error:  # 실패·JSON 아님 → Gemini -low
            reason = type(error).__name__
        else:
            return self.answer(data, 'json-deepseek', started, body)
        messages = json_messages(body['messages'])
        _assist_systems['chat-json'] = (messages[0]['content'], time.monotonic())
        try:
            data = via_agy({'messages': messages}, ASSIST_MODEL, max(3.0, JSON_BUDGET - (time.monotonic() - started)), short=True)
            message = data['choices'][0]['message']
            message['content'] = json.dumps(extract_json(message.get('content')), ensure_ascii=False)
        except Exception as error:
            log(route='json-agy-fallback', error=type(error).__name__, ds_error=reason, ms=self.elapsed(started))
            return self.reply(502, {'error': {'message': f'primary ({reason}) and fallback ({type(error).__name__}) failed'}})
        finally:
            threading.Thread(target=prewarm_assistant, daemon=True).start()
        self.answer(data, 'json-agy-fallback', started, body, ds_error=reason)


