    server.daemon_threads = True
    threading.Thread(target=keep_assistant_warm, daemon=True).start()
    log(event='start', listen=f'{HOST}:{PORT}', primary=DS_MODEL, effort=DS_EFFORT, fallback=AGY_MODEL, assistant=ASSIST_MODEL)
    server.serve_forever()
