// CD 전용(main): Hermes 의 e-class 프론트엔드(eclass.stack-edu.com)를 이 커밋으로 다시 빌드해 바꾼다.
// 검사는 GitHub Actions(.github/workflows/test.yml)가 PR 에서 맡는다. Jenkins 는 PR·브랜치를 빌드하지 않는다.
// Hermes 배포는 타입 검사(tsc)와 빌드에 실패하거나 헬스 확인이 안 되면 이전 dist 로 되돌린다.
// Jenkins·Hermes 배포 구성은 deploy/jenkins/README.md.
pipeline {
  agent none
  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 30, unit: 'MINUTES')
  }
  stages {
    stage('Deploy') {
      when { branch 'main' }
      agent any
      steps {
        withCredentials([sshUserPrivateKey(credentialsId: 'hermes-deploy', keyFileVariable: 'KEY')]) {
          sh 'ssh -i "$KEY" -o BatchMode=yes -o UserKnownHostsFile="$HERMES_KNOWN_HOSTS" "$HERMES_SSH" eclass-frontend "$GIT_COMMIT"'
        }
      }
    }
  }
}
